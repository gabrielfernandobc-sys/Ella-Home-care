*.xlsx
*.xls
*.ods
*.csv
*.xml
*.pdf
*.heic
*.HEIC
*.jpg
*.jpeg
*.JPG
*.JPEG
*.png
*.PNG
!/exemplos/**
!/public/**
!/src/**

# Dependências
/node_modules
/.pnp
.pnp.*

# Testes
/coverage

# Next.js
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts


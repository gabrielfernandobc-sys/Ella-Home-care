# Segredos e variáveis de ambiente (só o .env.example entra no Git)
.env
.env.*
!.env.example

# Credenciais OAuth, chaves e certificados
client_secret*.json
credentials*.json
credenciais*.json
token*.json
*.pem
*.key
*.p12
*.pfx
service-account*.json

# Dados locais do app: banco SQLite, uploads, planilha de demonstração
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Notas e planilhas reais que alguém possa copiar para a pasta por engano.

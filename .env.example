# =============================================================
# Compras Express — configuração local
# Copie este arquivo para ".env" (o iniciar.bat / iniciar.command
# faz isso sozinho na primeira vez) e preencha os valores.
# O arquivo .env NUNCA vai para o GitHub.
# =============================================================

# --- Google (login e planilha) ---------------------------------
# Veja o README, seção "Passo 2 — Google Cloud".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Inteligência artificial (leitura de fotos, prints e PDFs escaneados) ---
# Veja o README, seção "Passo 3 — Chave da IA".
# Notas em XML funcionam mesmo sem esta chave.
ANTHROPIC_API_KEY=

# --- Opcionais (pode deixar como está) --------------------------
# Modelo de IA usado na leitura dos documentos
CLAUDE_MODEL=claude-opus-5-5
# Quantos arquivos a IA lê ao mesmo tempo
CONCORRENCIA_IA=5
# Depois de quantos dias os arquivos enviados são apagados deste computador
RETENCAO_DIAS=30
# Porta local do app (o endereço será http://localhost:PORTA)
PORTA=3000
